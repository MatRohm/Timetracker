  <Project>

  <!--
    Generates the strongly-typed Strings accessor class from each project's
    Localization/Strings.resx at build time, so the .resx is the single source
    of truth and no hand-written Strings.Designer.cs is committed.

    The VS-only ResXFileCodeGenerator custom tool is ignored by the CLI build,
    and neither the MSBuild GenerateResource task (strongly-typed generation is
    refused on .NET Core: "ResGen.exe not supported") nor RoslynCodeTaskFactory
    (no reachable System.Xml reference assembly) can read the resx cross
    platform. So this target parses the resx itself with plain string methods —
    safe because the file is a string-only resx with a regular <data name="…">
    <value>…</value> shape — and emits the same minimal accessor shape the repo
    used to hand commit. It is guarded by the presence of
    Localization/Strings.resx so the test projects (which have no resx) are
    skipped.

    The accessor is written to Localization/Strings.Designer.cs in the source
    tree (gitignored, not committed) rather than obj/ so it shows up in the
    IDE's Solution Explorer, nested under Strings.resx via the DependentUpon
    metadata on the Compile item below.
  -->
  <UsingTask TaskName="GenerateStringsAccessor"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResxPath ParameterType="System.String" Required="true" />
      <NamespaceName ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
      <![CDATA[
        string Decode(string s)
        {
            return s
                .Replace("&amp;", "&").Replace("&lt;", "<").Replace("&gt;", ">")
                .Replace("&quot;", "\"").Replace("&apos;", "'")
                .Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        }

        string Encode(string s)
        {
            return s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
        }

        bool IsIdentifier(string s)
        {
            if (s.Length == 0 || !(char.IsLetter(s[0]) || s[0] == '_'))
                return false;
            for (int i = 1; i < s.Length; i++)
                if (!(char.IsLetterOrDigit(s[i]) || s[i] == '_'))
                    return false;
            return true;
        }

        var text = File.ReadAllText(ResxPath);
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     Generated from " + Path.GetFileName(ResxPath) + " at build time; do not edit.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine("#nullable enable");
        sb.AppendLine();
        sb.AppendLine("using System.Resources;");
        sb.AppendLine();
        sb.AppendLine("namespace " + NamespaceName + ";");
        sb.AppendLine();
        sb.AppendLine("/// <summary>The user-visible strings of this project.</summary>");
        sb.AppendLine("public static class Strings");
        sb.AppendLine("{");
        sb.AppendLine("    private static ResourceManager? _resourceManager;");
        sb.AppendLine();
        sb.AppendLine("    /// <summary>Returns the cached ResourceManager used by this class.</summary>");
        sb.AppendLine("    private static ResourceManager ResourceManager => _resourceManager ??= new ResourceManager(");
        sb.AppendLine("        \"" + NamespaceName + ".Strings\", typeof(Strings).Assembly);");
        sb.AppendLine();

        int index = 0;
        while (true)
        {
            int dataStart = text.IndexOf("<data ", index, StringComparison.Ordinal);
            if (dataStart < 0)
                break;
            int dataEnd = text.IndexOf("</data>", dataStart, StringComparison.Ordinal);
            if (dataEnd < 0)
            {
                Log.LogError("Malformed resx: a <data> block starting at offset " + dataStart + " has no closing </data>.");
                return false;
            }
            string block = text.Substring(dataStart, dataEnd - dataStart);

            string name = null;
            int nameStart = block.IndexOf("name=\"", StringComparison.Ordinal);
            if (nameStart >= 0)
            {
                nameStart += "name=\"".Length;
                int nameEnd = block.IndexOf('"', nameStart);
                name = block.Substring(nameStart, nameEnd - nameStart);
            }

            if (!string.IsNullOrEmpty(name))
            {
                if (!IsIdentifier(name))
                {
                    Log.LogError("Resource key '" + name + "' in " + Path.GetFileName(ResxPath) + " is not a valid C# identifier.");
                    return false;
                }

                string value = string.Empty;
                int valueStart = block.IndexOf("<value>", StringComparison.Ordinal);
                if (valueStart >= 0)
                {
                    valueStart += "<value>".Length;
                    int valueEnd = block.IndexOf("</value>", valueStart, StringComparison.Ordinal);
                    if (valueEnd >= 0)
                        value = block.Substring(valueStart, valueEnd - valueStart).Trim();
                }

                sb.AppendLine("    /// <summary>" + Encode(Decode(value)) + "</summary>");
                sb.AppendLine("    public static string " + name + " => ResourceManager.GetString(nameof(" + name + "))!;");
                sb.AppendLine();
            }

            index = dataEnd + "</data>".Length;
        }

        sb.AppendLine("}");

        var content = sb.ToString();
        if (!File.Exists(OutputPath) || File.ReadAllText(OutputPath) != content)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
            File.WriteAllText(OutputPath, content);
        }
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <ItemGroup Condition="Exists('Localization/Strings.resx')">
    <!-- Evaluated at load so the IDE nests the generated file under the resx
         and it is in @(Compile) even on a fresh clone before first generation.
         Remove+Include (rather than bare Include) avoids NETSDK1022, which
         fires when an explicit Compile item duplicates the default **/*.cs glob. -->
    <Compile Remove="Localization/Strings.Designer.cs" />
    <Compile Include="Localization/Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="GenerateStringsDesigner"
          BeforeTargets="CoreCompile"
          Condition="Exists('Localization/Strings.resx')">

    <GenerateStringsAccessor
      ResxPath="Localization/Strings.resx"
      NamespaceName="$(RootNamespace).Localization"
      OutputPath="Localization/Strings.Designer.cs" />
  </Target>

</Project>

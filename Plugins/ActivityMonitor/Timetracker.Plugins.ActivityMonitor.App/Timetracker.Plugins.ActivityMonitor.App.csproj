<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Timetracker.Plugins.ActivityMonitor.App</RootNamespace>
    <AssemblyName>Timetracker.Plugins.ActivityMonitor.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timetracker.Plugins.ActivityMonitor\Timetracker.Plugins.ActivityMonitor.csproj" />
  </ItemGroup>

  <!--
    This app is the headless monitor process: it hosts the gRPC status server
    (Kestrel + Grpc.AspNetCore) and runs the library's tracking loop as a hosted
    service. The ASP.NET Core shared framework lives here, not in the library the
    app references.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>

</Project>

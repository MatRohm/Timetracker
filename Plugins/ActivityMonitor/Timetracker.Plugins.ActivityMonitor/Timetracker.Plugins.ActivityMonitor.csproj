<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Timetracker.Plugins.ActivityMonitor</RootNamespace>
    <AssemblyName>Timetracker.Plugins.ActivityMonitor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Timetracker.Plugins.Contracts\Timetracker.Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timetracker.Plugins.ActivityMonitor.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dependency injection (IServiceProvider, GetRequiredService) and logging
      come from the base shared framework. The tracking loop's BackgroundService
      needs the generic-host abstractions (a small package, not ASP.NET Core).
    -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!--
    The library is the gRPC client: it asks the monitor app (which owns the
    status server) whether it is alive. The server lives in
    Timetracker.Plugins.ActivityMonitor.App, so the app, which references only
    this library, no longer carries the ASP.NET Core shared framework. Grpc.Tools
    generates the client and service stubs from ActivityMonitorStatus.proto.
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="ActivityMonitorStatus.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

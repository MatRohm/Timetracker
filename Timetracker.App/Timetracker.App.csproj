<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Timetracker</AssemblyName>
    <!-- The executable stays "Timetracker"; the namespaces use the project name. -->
    <RootNamespace>Timetracker.App</RootNamespace>
    <Version>1.0.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Embeds Timetracker.ico as the executable icon, which Windows uses for the
      taskbar, Alt-Tab and Explorer (Avalonia's per-window Icon only sets the
      window icon in the title bar). Not Windows-only: it is ignored elsewhere.
    -->
    <ApplicationIcon>Timetracker.ico</ApplicationIcon>
    <!--
      Bundle Avalonia's native libraries (libSkiaSharp, libHarfBuzzSharp) into the
      single-file executable and extract them on startup. Without this they are
      copied next to the executable instead, so a portable single file published
      from the release archive aborts at startup with a DllNotFoundException.
      Ignored unless PublishSingleFile is true.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugins\AzureDevOps\Timetracker.Plugins.AzureDevOps\Timetracker.Plugins.AzureDevOps.csproj" />
    <ProjectReference Include="..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor\Timetracker.Plugins.ActivityMonitor.csproj" />
    <ProjectReference Include="..\Plugins\WeekView\Timetracker.Plugins.WeekView\Timetracker.Plugins.WeekView.csproj" />
    <ProjectReference Include="..\Timetracker.Plugins.Contracts\Timetracker.Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timetracker.App.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- Transitive via Avalonia.FreeDesktop; pinned above the vulnerable 0.21.2. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Timetracker.png" />
  </ItemGroup>

  <!--
    Copy the activity monitor executable next to the published app: the monitor
    must stay a separate process (it outlives the tracker and starts at logon),
    so the installer looks for it in AppContext.BaseDirectory. The file name is
    platform-specific (no extension on Linux).
  -->
  <PropertyGroup>
    <ActivityMonitorFileName Condition="'$(RuntimeIdentifier)' == ''">Timetracker.Plugins.ActivityMonitor</ActivityMonitorFileName>
    <ActivityMonitorFileName Condition="$(RuntimeIdentifier.StartsWith('win'))">Timetracker.Plugins.ActivityMonitor.exe</ActivityMonitorFileName>
    <ActivityMonitorFileName Condition="'$(ActivityMonitorFileName)' == ''">Timetracker.Plugins.ActivityMonitor</ActivityMonitorFileName>
    <ActivityMonitorAppFileName Condition="'$(RuntimeIdentifier)' == ''">Timetracker.Plugins.ActivityMonitor.App</ActivityMonitorAppFileName>
    <ActivityMonitorAppFileName Condition="$(RuntimeIdentifier.StartsWith('win'))">Timetracker.Plugins.ActivityMonitor.App.exe</ActivityMonitorAppFileName>
    <ActivityMonitorAppFileName Condition="'$(ActivityMonitorAppFileName)' == ''">Timetracker.Plugins.ActivityMonitor.App</ActivityMonitorAppFileName>
  </PropertyGroup>

  <Target Name="PublishActivityMonitor" AfterTargets="Publish">
    <PropertyGroup>
      <ActivityMonitorOutputDir>$(MSBuildThisFileDirectory)..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor.App\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</ActivityMonitorOutputDir>
      <ActivityMonitorPublishOut>$(PublishDir)</ActivityMonitorPublishOut>
    </PropertyGroup>

    <!-- Restore the monitor app for the same RID first: it is not a ProjectReference of the app, so the publish does not restore it. -->
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor.App\Timetracker.Plugins.ActivityMonitor.App.csproj"
      Targets="Restore"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />

    <!-- Publish the monitor app for the same RID so its single-file exe sits next to the app. -->
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor.App\Timetracker.Plugins.ActivityMonitor.App.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);EnableCompressionInSingleFile=$(EnableCompressionInSingleFile);PublishDir=$(ActivityMonitorOutputDir)" />

    <!-- The monitor app publishes as Timetracker.Plugins.ActivityMonitor.App; rename to the name the installer expects. -->
    <Copy SourceFiles="$(ActivityMonitorOutputDir)$(ActivityMonitorAppFileName)" DestinationFiles="$(ActivityMonitorPublishOut)$(ActivityMonitorFileName)" SkipUnchangedFiles="true" Condition="Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorAppFileName)')" />
    <Message Text="Published activity monitor: $(ActivityMonitorOutputDir)$(ActivityMonitorAppFileName) -&gt; $(ActivityMonitorPublishOut)$(ActivityMonitorFileName)" Importance="high" Condition="Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorAppFileName)')" />
    <Warning Text="$(ActivityMonitorAppFileName) was not found to publish; the install button will not find the monitor." Condition="!Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorAppFileName)')" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Timetracker</AssemblyName>
    <!-- The executable and namespaces stay "Timetracker"; only the project is "App". -->
    <RootNamespace>Timetracker</RootNamespace>
    <Version>1.0.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Bundle Avalonia's native libraries (libSkiaSharp, libHarfBuzzSharp) into the
      single-file executable and extract them on startup. Without this they are
      copied next to the executable instead, so a portable single file published
      from the release archive aborts at startup with a DllNotFoundException.
      Ignored unless PublishSingleFile is true.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timetracker.AzureDevOps\Timetracker.AzureDevOps.csproj" />
    <ProjectReference Include="..\Timetracker.ActivityMonitor\Timetracker.ActivityMonitor.csproj" />
    <ProjectReference Include="..\Timetracker.Plugins\Timetracker.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- Transitive via Avalonia.FreeDesktop; pinned above the vulnerable 0.21.2. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Timetracker.png" />
  </ItemGroup>

  <!--
    Copy the activity monitor executable next to the published app: the monitor
    must stay a separate process (it outlives the tracker and starts at logon),
    so the installer looks for it in AppContext.BaseDirectory. The file name is
    platform-specific (no extension on Linux).
  -->
  <PropertyGroup>
    <ActivityMonitorFileName Condition="'$(RuntimeIdentifier)' == ''">Timetracker.ActivityMonitor</ActivityMonitorFileName>
    <ActivityMonitorFileName Condition="$(RuntimeIdentifier.StartsWith('win'))">Timetracker.ActivityMonitor.exe</ActivityMonitorFileName>
    <ActivityMonitorFileName Condition="'$(ActivityMonitorFileName)' == ''">Timetracker.ActivityMonitor</ActivityMonitorFileName>
  </PropertyGroup>

  <Target Name="PublishActivityMonitor" AfterTargets="Publish">
    <PropertyGroup>
      <ActivityMonitorOutputDir>$(MSBuildThisFileDirectory)..\Timetracker.ActivityMonitor\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</ActivityMonitorOutputDir>
      <ActivityMonitorPublishOut>$(PublishDir)</ActivityMonitorPublishOut>
    </PropertyGroup>

    <!-- Publish the monitor for the same RID so its single-file exe sits next to the app. -->
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Timetracker.ActivityMonitor\Timetracker.ActivityMonitor.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);EnableCompressionInSingleFile=$(EnableCompressionInSingleFile);PublishDir=$(ActivityMonitorOutputDir)" />

    <Copy SourceFiles="$(ActivityMonitorOutputDir)$(ActivityMonitorFileName)" DestinationFolder="$(ActivityMonitorPublishOut)" SkipUnchangedFiles="true" Condition="Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorFileName)')" />
    <Message Text="Published activity monitor: $(ActivityMonitorOutputDir)$(ActivityMonitorFileName) -&gt; $(ActivityMonitorPublishOut)" Importance="high" Condition="Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorFileName)')" />
    <Warning Text="$(ActivityMonitorFileName) was not found to publish; the install button will not find the monitor." Condition="!Exists('$(ActivityMonitorOutputDir)$(ActivityMonitorFileName)')" />
  </Target>

</Project>

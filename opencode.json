{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "agent": {
    "architecture-review": {
      "description": "Runs the architecture tests and reviews the code against SOLID; reports the findings as tables. Read-only.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/architecture-review.md}",
      "tools": { "write": false, "edit": false }
    },
    "grotz": {
      "description": "The testers. Hunt for crash weak points in the code and the app, then report the findings to the boss. Read-only.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/grotz.md}",
      "tools": { "write": false, "edit": false }
    }
  },
  "lsp": {
    "csharp": {
      "command": ["csharp-ls", "--solution", "Timetracker.App/Timetracker.App.csproj"],
      "extensions": [".cs", ".csx"]
    }
  }
}

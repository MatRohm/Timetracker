#!/bin/sh
#
# commit-msg hook: enforce Conventional Commits 1.0.0.
#
# See AGENTS.md ("Commit messages: Conventional Commits") and
# https://www.conventionalcommits.org/en/v1.0.0/
#
# The hook receives one argument: the path to the file holding the proposed
# commit message (the first line is the subject).
#
# A message is rejected unless the subject matches:
#
#     <type>[(scope)][!]: <description>
#
# where <type> is one of the allowed types below, the scope is optional and
# non-empty, the description is non-empty, and an optional breaking-change
# marker (!) may appear after the type/scope.
#
# Reverts produced by `git revert` and merge commits created by `git merge` are
# exempt: Git generates their messages and the user does not type them.
#
# To bypass the hook in an emergency, use `git commit --no-verify`.

set -eu

message_file=$1

# Allowed Conventional Commits types.
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

# Comment lines (#...) and leading blank lines are ignored by Git; drop them
# before reading the subject so `git commit -m` and editor commits behave alike.
subject=$(
    sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$message_file" | head -n 1
)

# Empty message (e.g. an aborted editor commit) is not ours to police.
[ -n "$subject" ] || exit 0

# Let Git-generated merge and revert messages through. `git revert` writes
# "Revert \"...\"" and a revert that follows the convention types it itself, so
# neither needs policing here.
case "$subject" in
    "Merge "* | "Revert "*) exit 0 ;;
esac

if printf '%s' "$subject" |
    grep -Eq "^($types)(\([^()]+\))?!?: .+$"; then
    exit 0
fi

cat >&2 <<EOF
✗ Commit message does not follow Conventional Commits.

  Got:      $subject
  Expected: <type>[optional scope][!]: <description>

  Allowed types: $(printf '%s' "$types" | tr '|' ' ')
  Examples:
    feat: add a per-item editor for tracking entries
    fix(activity-monitor): stop writing a duplicate span on shutdown
    docs: describe the line-ending setup
    refactor!: rename the app project to Timetracker.App

  See AGENTS.md and https://www.conventionalcommits.org/en/v1.0.0/
  (use "git commit --no-verify" to bypass in an emergency)

EOF
exit 1

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Timetracker</AssemblyName>
    <RootNamespace>Timetracker</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Timetracker.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timetracker.AzureDevOps\Timetracker.AzureDevOps.csproj" />
    <ProjectReference Include="..\Timetracker.ActivityMonitor\Timetracker.ActivityMonitor.csproj" />
    <ProjectReference Include="..\Timetracker.Plugins\Timetracker.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!--
    Copy the activity monitor exe next to the published single-file app: the
    monitor must stay a separate process (it outlives the tracker and starts
    with Windows), so the installer looks for it in AppContext.BaseDirectory.
  -->
  <Target Name="PublishActivityMonitor" AfterTargets="Publish">
    <PropertyGroup>
      <ActivityMonitorPublishDir>$(MSBuildThisFileDirectory)..\Timetracker.ActivityMonitor\bin\Release\$(TargetFramework)\win-x64\publish\</ActivityMonitorPublishDir>
      <ActivityMonitorPublishDir Condition="!Exists('$(ActivityMonitorPublishDir)')">$(MSBuildThisFileDirectory)..\Timetracker.ActivityMonitor\bin\Release\$(TargetFramework)\</ActivityMonitorPublishDir>
    </PropertyGroup>
    <Copy SourceFiles="$(ActivityMonitorPublishDir)Timetracker.ActivityMonitor.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(ActivityMonitorPublishDir)Timetracker.ActivityMonitor.exe')" />
    <Message Text="Published activity monitor: $(ActivityMonitorPublishDir)Timetracker.ActivityMonitor.exe -&gt; $(PublishDir)" Importance="high" Condition="Exists('$(ActivityMonitorPublishDir)Timetracker.ActivityMonitor.exe')" />
    <Warning Text="Timetracker.ActivityMonitor.exe was not found to publish; the install button will not find the monitor." Condition="!Exists('$(ActivityMonitorPublishDir)Timetracker.ActivityMonitor.exe')" />
  </Target>

</Project>
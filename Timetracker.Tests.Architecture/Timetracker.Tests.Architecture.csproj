<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <!--
    The architecture project inspects every other project. It must not reference
    Timetracker.App (or any product project other than Plugins) - that is one of the
    rules it enforces - so the projects are built but not compile-referenced
    (ReferenceOutputAssembly="false"). The tests analyse each assembly in its own
    project's output folder, listed in analysed-assemblies.txt (see below).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Timetracker.Plugins.Contracts\Timetracker.Plugins.Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.App\Timetracker.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\AzureDevOps\Timetracker.Plugins.AzureDevOps\Timetracker.Plugins.AzureDevOps.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor\Timetracker.Plugins.ActivityMonitor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor.App\Timetracker.Plugins.ActivityMonitor.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\WeekView\Timetracker.Plugins.WeekView\Timetracker.Plugins.WeekView.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.App.Tests.Unit\Timetracker.App.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\AzureDevOps\Timetracker.Plugins.AzureDevOps.Tests.Unit\Timetracker.Plugins.AzureDevOps.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\ActivityMonitor\Timetracker.Plugins.ActivityMonitor.Tests.Unit\Timetracker.Plugins.ActivityMonitor.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Plugins\WeekView\Timetracker.Plugins.WeekView.Tests.Unit\Timetracker.Plugins.WeekView.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Tests.UI\Timetracker.Tests.UI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Ask each referenced project for its actual output assembly (the same question
    MSBuild asks when it builds the reference, so Debug/Release and runtime
    identifiers are handled) and list the paths for SolutionArchitecture. The tests
    read these files directly instead of copies, so a copy can never go stale and
    pair a new test assembly with an old production assembly.
  -->
  <Target Name="WriteAnalysedAssemblyList" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" BuildInParallel="$(BuildInParallel)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="AnalysedAssembly" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)analysed-assemblies.txt" Lines="@(AnalysedAssembly->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>

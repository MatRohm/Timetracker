<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <!--
    The architecture project inspects every other project. It must not reference
    Timetracker.App (or any product project other than Plugins) - that is one of the
    rules it enforces - so the projects are built but not compile-referenced
    (ReferenceOutputAssembly="false") and their assemblies are copied next to this
    test host for analysis.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Timetracker.Plugins.Contracts\Timetracker.Plugins.Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.App\Timetracker.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Plugins.AzureDevOps\Timetracker.Plugins.AzureDevOps.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Plugins.ActivityMonitor\Timetracker.Plugins.ActivityMonitor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.App.Tests.Unit\Timetracker.App.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Plugins.AzureDevOps.Tests.Unit\Timetracker.Plugins.AzureDevOps.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Plugins.ActivityMonitor.Tests.Unit\Timetracker.Plugins.ActivityMonitor.Tests.Unit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Timetracker.Tests.UI\Timetracker.Tests.UI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AnalysisAssembly Include="..\Timetracker.App\bin\$(Configuration)\$(TargetFramework)\Timetracker.dll" />
    <AnalysisAssembly Include="..\Timetracker.Plugins.Contracts\bin\$(Configuration)\$(TargetFramework)\Timetracker.Plugins.Contracts.dll" />
    <AnalysisAssembly Include="..\Timetracker.Plugins.AzureDevOps\bin\$(Configuration)\$(TargetFramework)\Timetracker.Plugins.AzureDevOps.dll" />
    <AnalysisAssembly Include="..\Timetracker.Plugins.ActivityMonitor\bin\$(Configuration)\$(TargetFramework)\Timetracker.Plugins.ActivityMonitor.dll" />
    <AnalysisAssembly Include="..\Timetracker.App.Tests.Unit\bin\$(Configuration)\$(TargetFramework)\Timetracker.App.Tests.Unit.dll" />
    <AnalysisAssembly Include="..\Timetracker.Plugins.AzureDevOps.Tests.Unit\bin\$(Configuration)\$(TargetFramework)\Timetracker.Plugins.AzureDevOps.Tests.Unit.dll" />
    <AnalysisAssembly Include="..\Timetracker.Plugins.ActivityMonitor.Tests.Unit\bin\$(Configuration)\$(TargetFramework)\Timetracker.Plugins.ActivityMonitor.Tests.Unit.dll" />
    <AnalysisAssembly Include="..\Timetracker.Tests.UI\bin\$(Configuration)\$(TargetFramework)\Timetracker.Tests.UI.dll" />
  </ItemGroup>

  <!-- Copy the analysed assemblies next to the test host, after they are built. -->
  <Target Name="CopyAnalysedAssemblies" AfterTargets="Build">
    <Copy SourceFiles="@(AnalysisAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
